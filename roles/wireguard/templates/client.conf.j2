# {{item.name}}: generated by the home-server wireguard role. Contains a private key.
[Interface]
PrivateKey = {{wireguard_peer_private_keys[item.name]}}
Address = {{item.address}}/32
DNS = {{web_server_ip}}

[Peer]
PublicKey = {{wireguard_server_pubkey_result.stdout}}
Endpoint = home.{{parent_domain}}:{{wireguard_port}}
# Split tunnel: only this server and studio go through home.
AllowedIPs = {{wireguard_server_address}}/32, {{web_server_ip}}/32, {{studio_ip}}/32
