server {
	server_name {{domain}};
	# HTTP2Shell (CVE-2026-111497): see the map in nginx.conf.
	if ($reject_brotli_body) { return 415; }
    client_max_body_size 1024M;

    # Temporary: LAN/VPN only until the nextcloud image ships PHP >= 8.5.12
    # (PHP2Shell, GHSA-w8hw-w9fx-j79w / GHSA-6wmf-4rv5-p3rp).
    allow {{local_network}};
    allow {{wireguard_subnet}};
    deny all;

    location ^~ /.well-known {
        location = /.well-known/carddav { return 301 /remote.php/dav/; }
        location = /.well-known/caldav  { return 301 /remote.php/dav/; }

        location /.well-known/acme-challenge    { try_files $uri $uri/ =404; }
        location /.well-known/pki-validation    { try_files $uri $uri/ =404; }

        # Let Nextcloud's API for `/.well-known` URIs handle all other
        # requests by passing them to the front-end controller.
        return 301 /index.php$request_uri;
    }

	location / {
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $host;
		proxy_pass http://localhost:{{service_port}};
	}
	listen 443 ssl;
    add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;

    ssl_certificate /etc/letsencrypt/live/home.tristanhavelick.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/home.tristanhavelick.com/privkey.pem;
}

server {
    if ($host = {{domain}}) {
        return 301 https://$host$request_uri;
    }
	server_name {{domain}};
    listen 80;
    return 404;
}