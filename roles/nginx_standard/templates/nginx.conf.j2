server {
	server_name {{domain}};
	# HTTP2Shell (CVE-2026-111497): see the map in nginx.conf.
	if ($reject_brotli_body) { return 415; }
{% if lan_only %}
	# LAN/VPN only; public_paths below stay reachable from the internet.
	include snippets/lan_only.conf;
{% endif %}
{% for location in ['/'] + (public_paths if lan_only else []) %}
	location {{location}} {
{% if location != '/' %}
		allow all;
		# Limits are per client IP (zones in nginx.conf).
		limit_req zone=public_paths burst=10 nodelay;
		limit_conn public_conn 10;
{% endif %}
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection "upgrade";
		proxy_pass http://localhost:{{service_port}};
	}
{% endfor %}
	listen 443 ssl;
    add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;

    ssl_certificate /etc/letsencrypt/live/home.tristanhavelick.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/home.tristanhavelick.com/privkey.pem;
}

